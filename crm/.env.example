# Copia este fichero a crm/.env (o exporta las variables como prefieras) y
# rellena los valores reales. NUNCA subas crm/.env a git (ya está en .gitignore).
# Guía completa de cada variable: ver CRM_LEADS.md en la raíz del repo.

# --- Servidor ---
CRM_PORT=8787
CRM_DATA_FILE=crm/data/leads.json

# --- Dashboard y API (Basic Auth) ---
CRM_USER=
CRM_PASS=

# --- Meta Lead Ads (Facebook/Instagram) ---
# App de Meta for Developers > producto Webhooks > suscripción "leadgen".
META_VERIFY_TOKEN=
META_APP_SECRET=
# Token de página de larga duración con permiso leads_retrieval.
META_PAGE_ACCESS_TOKEN=
META_API_VERSION=v21.0

# --- Google Ads (Lead Form webhook delivery) ---
# La misma clave que pongas en Google Ads al configurar el webhook.
GOOGLE_ADS_WEBHOOK_KEY=

# --- Formularios web ---
# Una clave por sitio/cliente: "sitio1:clave1,sitio2:clave2"
# Vacío = modo abierto (acepta cualquier envío sin clave). Úsalo solo en desarrollo.
WEBFORM_API_KEYS=
WEBFORM_CORS_ORIGIN=*
