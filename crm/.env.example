# Copia este fichero a crm/.env (o exporta las variables como prefieras) y
# rellena los valores reales. NUNCA subas crm/.env a git (ya está en .gitignore).
# Guía completa de cada variable: ver CRM_LEADS.md en la raíz del repo.

# --- Servidor ---
CRM_PORT=8787
CRM_DATA_FILE=crm/data/leads.json

# --- Dashboard y API (Basic Auth) ---
CRM_USER=
CRM_PASS=

# --- Meta Lead Ads (Facebook/Instagram) ---
# App de Meta for Developers > producto Webhooks > suscripción "leadgen".
META_VERIFY_TOKEN=
META_APP_SECRET=
# Token de página de larga duración con permiso leads_retrieval.
META_PAGE_ACCESS_TOKEN=
META_API_VERSION=v21.0

# --- Google Ads (Lead Form webhook delivery) ---
# La misma clave que pongas en Google Ads al configurar el webhook.
GOOGLE_ADS_WEBHOOK_KEY=

# --- Formularios web ---
# Una clave por sitio/cliente: "sitio1:clave1,sitio2:clave2"
# Vacío = modo abierto (acepta cualquier envío sin clave). Úsalo solo en desarrollo.
WEBFORM_API_KEYS=
WEBFORM_CORS_ORIGIN=*

# --- Secuencia de bienvenida (3 correos automáticos, ver crm/lib/sequence.mjs) ---
# SMTP propio (p. ej. el Gmail de la agencia con una "contraseña de aplicación",
# no la contraseña normal). Sin SMTP_HOST/SMTP_USER, la secuencia queda
# construida pero no manda nada: los pasos se quedan "pendiente".
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Remitente que verá el lead; si se deja vacío se usa SMTP_USER.
SMTP_FROM=

# Datos de la agencia que se usan en el texto de los correos. El paso "web"
# y el paso "newsletter" se quedan pendientes hasta que su URL correspondiente
# tenga valor (así nunca sale un correo con un enlace vacío).
AGENCY_NAME=Santiso Marketing
AGENCY_SENDER_NAME=Santiso Marketing
AGENCY_WEBSITE_URL=
AGENCY_NEWSLETTER_URL=

# Cada cuántos minutos se revisan los pasos de la secuencia con retraso
# (la confirmación inmediata no espera a este barrido).
SEQUENCE_CHECK_INTERVAL_MINUTES=5

# --- Aviso al equipo (no al lead — usa el mismo SMTP_* de arriba) ---
# A quién avisar de cada lead nuevo y del recordatorio de pendientes.
# Admite varios separados por coma. Vacío = no se avisa a nadie.
TEAM_NOTIFY_EMAIL=santisomarketing@gmail.com

# Cada cuánto se repite el recordatorio de "leads sin cerrar" MIENTRAS quede
# alguno abierto (ni ganado ni perdido) — es la red de seguridad para que
# ninguno se escape. El aviso de lead nuevo es siempre inmediato, esto es
# solo el recordatorio periódico.
REMINDER_INTERVAL_MINUTES=240

# URL pública del CRM ya desplegado (sin barra final), para que los avisos
# al equipo enlacen directo al lead. Vacío = correos sin enlace.
CRM_PUBLIC_URL=
