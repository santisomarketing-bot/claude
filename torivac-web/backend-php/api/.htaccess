# API de Torivac: LISTA BLANCA. Desde la web solo se sirve index.php; todo lo demás de esta carpeta
# (lib/, tools/, tests/, generated/, storage/, cron.php, config.php, copias como config.php.bak o config.php~, error_log, .env, *.zip…) queda cerrado.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "^index\.php$">
    Require all allowed
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "^index\.php$">
    Order allow,deny
    Allow from all
  </FilesMatch>
</IfModule>
